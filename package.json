{
  "name": "@kaws/dsh-theme",
  "version": "1.0.0",
  "private": true,
  "description": "KAWS Companion theme for DeepSeek Harness: charcoal, bone, crimson, teal, XX eyes, and streetwear edges.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "companion.png",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md"
  ],
  "license": "MIT",
  "author": "Sean Montecillo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delmontecillo/dsh-kaws-theme.git"
  },
  "homepage": "https://github.com/delmontecillo/dsh-kaws-theme#readme",
  "bugs": {
    "url": "https://github.com/delmontecillo/dsh-kaws-theme/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
